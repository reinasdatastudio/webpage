theme_minimal(base_size = 13)
library(scales)
plot_data <- reac_outc %>%
group_by(five_or_more_reactions) %>%
summarise(
n_cases = n(),
n_severe = sum(Severity == "Severe", na.rm = TRUE),
prop_severe = n_severe / n_cases
)
ggplot(plot_data, aes(x = reac_outc$five_or_more_reactions, y = prop_severe)) +
geom_col(fill = "#ddf", width = 0.6) +
scale_y_continuous(labels = percent_format(accuracy = 1)) +
labs(
title = "Severe outcomes by number of reported reactions",
subtitle = "FAERS 2025 Q3 (case-level)",
x = "Number of reactions reported per case",
y = "Proportion with death or hospitalisation"
) +
theme_minimal(base_size = 13)
