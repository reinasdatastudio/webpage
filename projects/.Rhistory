reac_per_case <- reac %>% count(caseid)
library(dplyr)
library(data.table)
reac <- fread(
"FAERS/REAC25Q3.txt",
sep="$",
quote = "",
fill = TRUE,
encoding = "UTF-8"
)
head(reac)
nrow(reac)
reac_per_case <- reac %>% count(caseid)
#Same as reac_per_case <- reac |> dplyr::count(primaryid)
View(reac_per_case)
#Count how many incidents on average
reac_per_case %>% count(n)
#Count the count of reactions per case (E.g. 100 cases have 1 reaction etc.)
reac_per_case %>% count(n, name = "How many cases have n reactions")
View(reac)
