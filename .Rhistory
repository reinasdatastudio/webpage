library(data.table)
library(dplyr)
library(scales)
library(knitr)
#| tbl-cap: REAC table
reac <- fread(
"FAERS/REAC25Q3.txt",
sep="$",
quote = "",
fill = TRUE,
encoding = "UTF-8"
)
kable(head(reac))
colnames(reac)
# Number of rows in REAC table
nrow(reac)
# How many primary IDs are in the table
length(unique(reac$primaryid))
# How many unique case IDs are there
length(unique(reac$caseid))
reac_new <- select(reac, -"primaryid")
reac_new <- reac_new %>%
distinct()
reac_per_case <- reac_new %>%
distinct(caseid, pt) %>%
count(caseid, name = "Number of reaction")
#Same as reac_per_case <- reac |> dplyr::count(primaryid)
#Count the number of reactions per case (E.g. 100 cases have 1 reaction etc.)
reac_count <- reac_per_case %>% count(`Number of reaction`) %>% rename(num_reactions = `Number of reaction`, num_cases = n)
kable(head(reac_count, 5))
#Summary of number of reactions
summary(reac_per_case$`Number of reaction`)
#IQR of number of reactions
IQR(reac_per_case$`Number of reaction`)
library(ggplot2)
#binwidth = sqrt(number of observation)
ggplot(reac_per_case, aes(`Number of reaction`)) +
geom_histogram(binwidth = 1) +
theme_minimal()
#| tbl-cap: Check for missing data
kable(reac_new %>%
summarise(across(c(caseid, pt), ~sum(is.na(.)))))
length(unique(reac_new$pt))
top_pt <- reac_new %>%
count(pt) %>%
arrange(desc(n)) %>%
slice(1:10)
kable(top_pt)
top_pt <- reac_new %>%
count(pt) %>%
arrange(desc(n)) %>%
rename(n = "Count") %>%
slice(1:10)
top_pt <- reac_new %>%
count(pt) %>%
arrange(desc(n)) %>%
rename(`Count` = n) %>%
slice(1:10)
kable(top_pt)
ggplot(reac_new, aes(x = pt)) +
geom_bar()
ggplot(top_pt, aes(x = pt, y = n)) +
geom_col()
ggplot(top_pt, aes(x = pt, y = Count)) +
geom_col()
ggplot(top_pt, aes(x = pt, y = Count)) +
geom_col() +
theme_minimal()
ggplot(top_pt, aes(x = reorder(pt, -Count), y = Count)) +
geom_col() +
theme_minimal()
ggplot(top_pt, aes(x = reorder(pt, -Count), y = Count)) +
geom_col() +
labs(x="pt") +
theme(axis.text.x = element_text(angle = 45, vjust = 0.5, hjust = 1)) +
theme_minimal()
ggplot(top_pt, aes(x = reorder(pt, -Count), y = Count)) +
geom_col() +
labs(x="pt") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1)) +
theme_minimal()
ggplot(top_pt, aes(x = reorder(pt, -Count), y = Count)) +
geom_col() +
labs(x="pt") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1))
ggplot(top_pt, aes(x = reorder(pt, -Count), y = Count)) +
geom_col() +
labs(x="pt") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1), panel.grid.minor = element_blank())
ggplot(top_pt, aes(x = reorder(pt, -Count), y = Count)) +
geom_col() +
labs(x="pt") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1), panel.background = element_blank())
